          { "registryType": "nuget", "identifier": "Example.Mcp", "version": "0.3.0", "transport": { "type": "stdio" } },
          { "registryType": "cargo", "identifier": "example-mcp", "version": "0.3.0" }
        ]
      },
      "_meta": { "io.modelcontextprotocol.registry/official": { "status": "active", "isLatest": true } }
    },
    { "server": { "name": "io.github.example/unreadable" } }
