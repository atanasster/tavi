{
  "name": "@tavi/ui",
  "version": "0.3.0",
  "private": true,
  "license": "MIT",
  "author": "atanasster",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atanasster/tavi.git",
    "directory": "apps/ui"
  },
  "homepage": "https://github.com/atanasster/tavi#readme",
  "bugs": {
    "url": "https://github.com/atanasster/tavi/issues"
  },
  "type": "module",
  "description": "The tavi web canvas: a static bundle `tavi ui` serves, shipped inside @tavi/cli (never installed as a package)",
  "scripts": {
    "build": "vite build && node scripts/copy-plugins.mjs && pnpm --workspace-root run notices . dist/THIRD-PARTY-NOTICES.txt \"Third-party software bundled into the web canvas.\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint:css": "stylelint \"src/styles/**/*.css\"",
    "analyze": "pnpm run build && node scripts/analyze.mjs",
    "test": "vitest run"
  },
  "taviBundled": [
    "@fontsource-variable/bricolage-grotesque",
    "@fontsource-variable/inter",
    "@radix-ui/react-select",
    "katex",
    "react",
    "react-dom",
    "react-markdown",
    "rehype-highlight",
    "rehype-katex",
    "remark-breaks",
    "remark-gfm",
    "remark-math",
    "uqr",
    "zod"
  ],
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@radix-ui/react-select": "2.4.1",
    "@tavi/client": "workspace:*",
    "@tavi/contracts": "workspace:*",
    "@tavi/plugin-browser-view": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "axe-core": "4.14.1",
    "jsdom": "catalog:",
    "katex": "0.19.1",
    "react": "catalog:",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "rehype-katex": "7.0.1",
    "remark-breaks": "4.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "stylelint": "17.16.0",
    "typescript": "catalog:",
    "uqr": "0.1.3",
    "vite": "8.3.8",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
