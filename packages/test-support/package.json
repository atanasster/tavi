    ".": "./src/index.ts",
    "./discord": "./src/discord.ts",
    "./fakes": "./src/fakes.ts",
    "./fixtures": "./src/fixtures.ts",
    "./messaging": "./src/messaging.ts",
    "./openai-stub": "./src/openai-stub.ts",
    "./plugin-worker": "./src/plugin-worker.ts",
    "./prefix": "./src/prefix.ts",
    "./routine-templates": "./src/routine-templates.ts",
    "./sandbox": "./src/sandbox.ts",
    "./site": "./src/site.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@langchain/langgraph-checkpoint-sqlite": "catalog:",
    "@tavi/contracts": "workspace:*",
