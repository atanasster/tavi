{
  "name": "@tavi/domain-kit",
  "version": "0.3.1",
  "private": true,
  "license": "MIT",
  "author": "atanasster",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atanasster/tavi.git",
    "directory": "packages/domain-kit"
  },
  "homepage": "https://github.com/atanasster/tavi#readme",
  "bugs": {
    "url": "https://github.com/atanasster/tavi/issues"
  },
  "type": "module",
  "sideEffects": false,
  "description": "What every domain plugin's worker shares: its SQLite store's migrations, per-source budgets, the release check of its sources' terms, the bounded request it makes, MinHash, its tools' input schemas drawn with a given Zod, and the script that assembles its dist-plugin/",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./assemble-plugin": "./scripts/assemble-plugin.mjs"
  },
  "files": [
    "dist",
    "scripts"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@tavi/contracts": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tavi/test-support": "workspace:*",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    }
  }
}
