{
  "network": {
    "allowedDomains": [],
    "deniedDomains": [],
    "strictAllowlist": true
  },
  "filesystem": {
    "denyRead": [
      "/home/person",
      "/srv/tavi-data",
      "/tmp"
    ],
    "allowRead": [
      "/work/project",
      "/srv/tavi-data/chats/default/t1"
    ],
    "allowWrite": [
      "/work/project",
      "/srv/tavi-data/chats/default/t1"
    ],
    "denyWrite": [
      "/home/person/.ssh",
      "/work/project/**/.[gG][iI][tT]",
      "/work/project/**/.[gG][iI][tT]/[hH][oO][oO][kK][sS]",
      "/work/project/**/.[gG][iI][tT]/[cC][oO][nN][fF][iI][gG]",
      "/work/project/**/.[bB][aA][sS][hH][rR][cC]",
      "/work/project/**/.[zZ][sS][hH][rR][cC]",
      "/work/project/**/.[pP][rR][oO][fF][iI][lL][eE]",
      "/work/project/**/.[eE][nN][vV][rR][cC]",
      "/work/project/**/.[vV][sS][cC][oO][dD][eE]",
      "/work/project/**/.[iI][dD][eE][aA]",
      "/work/project/**/.[cC][lL][aA][uU][dD][eE]/[sS][eE][tT][tT][iI][nN][gG][sS].[jJ][sS][oO][nN]",
      "/work/project/[hH][eE][aA][dD]",
      "/private/tmp/claude",
      "/tmp/claude",
      "/home/person/.npm/_logs",
      "/home/person/.claude/debug",
      {
        "path": "/work/project/wt/.git",
        "literal": true
      },
      {
        "path": "/work/project/.git/worktrees/wt/hooks",
        "literal": true
      },
      {
        "path": "/work/project/.git/worktrees/wt/config",
        "literal": true
      },
      {
        "path": "/work/project/.git/worktrees/wt/config.worktree",
        "literal": true
      },
      {
        "path": "/work/project/.git/worktrees/wt/commondir",
        "literal": true
      },
      {
        "path": "/work/project/.git/worktrees/wt/HEAD",
        "literal": true
      },
      {
        "path": "/work/project/.git/hooks",
        "literal": true
      },
      {
        "path": "/work/project/.git/config",
        "literal": true
      },
      {
        "path": "/work/project/.git/config.worktree",
        "literal": true
      },
      {
        "path": "/work/project/.git/commondir",
        "literal": true
      },
      {
        "path": "/work/project/.git/HEAD",
        "literal": true
      }
    ]
  },
  "credentials": {
    "envVars": [
      {
        "name": "OPENAI_API_KEY",
        "mode": "deny"
      },
      {
        "name": "ANTHROPIC_API_KEY",
        "mode": "deny"
      }
    ]
  }
}
