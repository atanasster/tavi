{
  // The launchers in bin/ ship as they are (Playwright's executable and the shim inside the sandbox), unbuilt:
  // type-check them as JavaScript.
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true
  },
  "include": ["bin/*.mjs"]
}
