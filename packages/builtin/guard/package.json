{
  "name": "@tavi/plugin-guard",
  "version": "0.4.2",
  "private": true,
  "license": "MIT",
  "author": "atanasster",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atanasster/tavi.git",
    "directory": "packages/builtin/guard"
  },
  "homepage": "https://github.com/atanasster/tavi#readme",
  "bugs": {
    "url": "https://github.com/atanasster/tavi/issues"
  },
  "type": "module",
  "description": "tavi.guard: a first-party mod, off until enabled, that asks before a sandbox.run command that deletes or overwrites, and says what it would touch",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./manifest": {
      "development": "./src/manifest.ts",
      "types": "./dist/manifest.d.mts",
      "import": "./dist/manifest.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@tavi/contracts": "workspace:*"
  },
  "devDependencies": {
    "@tavi/test-support": "workspace:*",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      },
      "./manifest": {
        "types": "./dist/manifest.d.mts",
        "import": "./dist/manifest.mjs"
      },
      "./package.json": "./package.json"
    }
  }
}
