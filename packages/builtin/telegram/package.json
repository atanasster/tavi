{
  "name": "@tavi/plugin-telegram",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "author": "atanasster",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atanasster/tavi.git",
    "directory": "packages/builtin/telegram"
  },
  "homepage": "https://github.com/atanasster/tavi#readme",
  "bugs": {
    "url": "https://github.com/atanasster/tavi/issues"
  },
  "type": "module",
  "description": "Real Telegram MessagingConnectorPort adapter, long-polling only",
  "exports": {
    "./channel": {
      "development": "./src/channel.ts",
      "types": "./dist/channel.d.mts",
      "import": "./dist/channel.mjs"
    },
    "./connector": {
      "development": "./src/connector.ts",
      "types": "./dist/connector.d.mts",
      "import": "./dist/connector.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@tavi/channel-kit": "workspace:*",
    "@tavi/contracts": "workspace:*",
    "@tavi/node-kit": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "exports": {
      "./channel": {
        "types": "./dist/channel.d.mts",
        "import": "./dist/channel.mjs"
      },
      "./connector": {
        "types": "./dist/connector.d.mts",
        "import": "./dist/connector.mjs"
      },
      "./package.json": "./package.json"
    }
  }
}
