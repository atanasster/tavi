{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    // The viewer is a page (the DOM, no Node); the manifest and the tests run in Node.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "*.config.ts"],
  // The root tsconfig.tests.json checks it: it imports the repository's vitest.config.ts, which a declaration
  // build of this package (tsdown's dts) would otherwise emit beside its source at the repository root.
  "exclude": ["vitest.config.ts"]
}
