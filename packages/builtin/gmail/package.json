{
  "name": "@tavi/plugin-gmail",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "author": "atanasster",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atanasster/tavi.git",
    "directory": "packages/builtin/gmail"
  },
  "homepage": "https://github.com/atanasster/tavi#readme",
  "bugs": {
    "url": "https://github.com/atanasster/tavi/issues"
  },
  "type": "module",
  "description": "Gmail as a messaging channel: OAuth sign-in through the host, inbound by a labelled query, replies in the thread",
  "exports": {
    "./connector": {
      "development": "./src/connector.ts",
      "types": "./dist/connector.d.mts",
      "import": "./dist/connector.mjs"
    },
    "./tools": {
      "development": "./src/tools.ts",
      "types": "./dist/tools.d.mts",
      "import": "./dist/tools.mjs"
    },
    "./channel": {
      "development": "./src/channel.ts",
      "types": "./dist/channel.d.mts",
      "import": "./dist/channel.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@tavi/channel-kit": "workspace:*",
    "@tavi/contracts": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "exports": {
      "./connector": {
        "types": "./dist/connector.d.mts",
        "import": "./dist/connector.mjs"
      },
      "./package.json": "./package.json",
      "./tools": {
        "types": "./dist/tools.d.mts",
        "import": "./dist/tools.mjs"
      },
      "./channel": {
        "types": "./dist/channel.d.mts",
        "import": "./dist/channel.mjs"
      }
    }
  }
}
