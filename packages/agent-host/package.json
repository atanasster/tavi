      "development": "./src/schedulers/reminder-scheduler.ts",
      "types": "./dist/reminder-scheduler.d.mts",
      "import": "./dist/reminder-scheduler.mjs"
    },
    "./task-summarizer": {
      "development": "./src/schedulers/task-summarizer.ts",
      "types": "./dist/task-summarizer.d.mts",
      "import": "./dist/task-summarizer.mjs"
    },
    "./checkpoint": {
      "development": "./src/workflow/checkpoint.ts",
      "types": "./dist/checkpoint.d.mts",
      "import": "./dist/checkpoint.mjs"
    },
    "./onboarding-host": {
      "development": "./src/hosts/onboarding-host.ts",
      "types": "./dist/onboarding-host.d.mts",
      "import": "./dist/onboarding-host.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.105",
    "@ai-sdk/openai": "4.0.118",
    "@ai-sdk/provider": "4.0.38",
