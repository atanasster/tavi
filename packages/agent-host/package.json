    "./heartbeat-host": {
      "development": "./src/hosts/heartbeat-host.ts",
      "types": "./dist/heartbeat-host.d.mts",
      "import": "./dist/heartbeat-host.mjs"
    },
    "./ideas-host": {
      "development": "./src/hosts/ideas-host.ts",
      "types": "./dist/ideas-host.d.mts",
      "import": "./dist/ideas-host.mjs"
    },
    "./unattended-admission": {
      "development": "./src/schedulers/unattended-admission.ts",
      "types": "./dist/unattended-admission.d.mts",
      "import": "./dist/unattended-admission.mjs"
