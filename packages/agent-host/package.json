  "homepage": "https://github.com/atanasster/tavi#readme",
  "bugs": {
    "url": "https://github.com/atanasster/tavi/issues"
  },
  "type": "module",
  "sideEffects": false,
  "description": "The agent host: models (Vercel AI SDK), the task workflow (LangGraph), context assembly, tool routing, the system prompt, and the heartbeat, ideas, onboarding and memory hosts",
  "exports": {
    "./models": {
      "development": "./src/models/models.ts",
      "types": "./dist/models.d.mts",
      "import": "./dist/models.mjs"
    },
    "./openai-stream-compat": {
      "development": "./src/models/openai-stream-compat.ts",
      "types": "./dist/openai-stream-compat.d.mts",
      "import": "./dist/openai-stream-compat.mjs"
    },
    "./workflow": {
      "development": "./src/workflow/index.ts",
      "types": "./dist/workflow.d.mts",
      "import": "./dist/workflow.mjs"
    },
    "./system-prompt": {
      "development": "./src/prompts/system-prompt.ts",
      "types": "./dist/system-prompt.d.mts",
      "import": "./dist/system-prompt.mjs"
    },
