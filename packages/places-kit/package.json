{
  "name": "@tavi/places-kit",
  "version": "0.4.1",
  "private": true,
  "license": "MIT",
  "author": "atanasster",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atanasster/tavi.git",
    "directory": "packages/places-kit"
  },
  "homepage": "https://github.com/atanasster/tavi#readme",
  "bugs": {
    "url": "https://github.com/atanasster/tavi/issues"
  },
  "type": "module",
  "sideEffects": false,
  "description": "The places domain's library: source records and adapters, normalisation, entity resolution, opening hours and the store's schema. No network and no runtime imports: the places plugins' workers run it",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@tavi/contracts": "workspace:*",
    "@tavi/domain-kit": "workspace:*",
    "hyparquet": "catalog:",
    "hyparquet-compressors": "1.1.3",
    "libphonenumber-js": "1.13.16",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tavi/test-support": "workspace:*",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    }
  }
}
