{
  "name": "@tavi/client",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "author": "atanasster",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atanasster/tavi.git",
    "directory": "packages/client"
  },
  "homepage": "https://github.com/atanasster/tavi#readme",
  "bugs": {
    "url": "https://github.com/atanasster/tavi/issues"
  },
  "type": "module",
  "sideEffects": false,
  "description": "The attached client of a tavi owner: frames, reconnect and reducers, React- and Node-free at its root",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./node": {
      "development": "./src/node.ts",
      "types": "./dist/node.d.mts",
      "import": "./dist/node.mjs"
    },
    "./browser": {
      "development": "./src/browser.ts",
      "types": "./dist/browser.d.mts",
      "import": "./dist/browser.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.neutral.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@tavi/contracts": "workspace:*"
  },
  "devDependencies": {
    "@tavi/test-support": "workspace:*",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      },
      "./node": {
        "types": "./dist/node.d.mts",
        "import": "./dist/node.mjs"
      },
      "./browser": {
        "types": "./dist/browser.d.mts",
        "import": "./dist/browser.mjs"
      },
      "./package.json": "./package.json"
    }
  }
}
