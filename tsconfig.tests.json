{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "noEmit": true
  },
  // Each workspace's vitest.config.ts is checked here, not in its own tsconfig (see the exclude there).
  "include": [
    "tests/**/*.ts",
    "evals/**/*.ts",
    "*.config.ts",
    "apps/*/vitest.config.ts",
    "packages/*/vitest.config.ts",
    "packages/*/*/vitest.config.ts"
  ],
  // The guide walks read the page's DOM, so they are checked with the DOM types, apart (tsconfig.guides.json):
  // beside them the browser plugin's sources, which the integration tests import, would be checked against
  // types their own package never sees.
  "exclude": ["tests/guides/**", "tests/guide-*.test.ts"]
}
